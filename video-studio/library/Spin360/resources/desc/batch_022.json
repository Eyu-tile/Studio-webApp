   "bya_description": "Infant sleeps in a white crib while sunlight filters through blinds.",
   "bya_tags": [
    "Bedroom",
    "Creator narration",
    "Fan controls",
    "Bedroom",
    "Curtains & windows",
    "Fan controls",
    "Feeling the breeze",

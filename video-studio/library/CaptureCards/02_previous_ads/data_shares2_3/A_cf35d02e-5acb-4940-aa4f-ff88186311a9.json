, ["if", 81.84, 81.94], ["your", 81.94, 82.22], ["bed", 82.22, 82.42], ["is", 82.42, 82.58], ["the", 82.58, 82.68], ["problem.", 82.68, 83.0]], "segments": [[0.0, 2.8, "If you're allergic to dust mites, you wanna hear this."], [3.02, 5.7, "And yeah, I know exactly what you're thinking right now."], [5.9, 7.56, "And honestly, I don't blame you"], [7.56, 8.7, "because I think it too."], [8.9, 12.08, "Every single time a Facebook ad promises to fix something."], [12.36, 14.02, "So before I say anything else,"], [14.18, 16.52, "there's a 90 day money back guarantee on this."], [16.8, 17.62, "No return required."], [17.9, 19.2, "You don't have to ship anything back"], [19.2, 20.78, "or fight anyone for a refund."], [21.06, 22.92, "If it doesn't work for you, you get your money back."], [23.1, 24.08, "Here's what got me though."], [24.22, 25.58, "I'd been doing everything right."], [25.84, 27.5, "Air purifier running all night,"], [27.76, 29.12, "washing my sheets constantly."], [29.12, 32.4, "And I still woke up every morning stuffed up and foggy,"], [32.5, 33.52, "like I'd barely slept."], [33.82, 35.16, "Then I realized I'd been cleaning"], [35.16, 36.52, "the wrong part of my bedroom."], [36.82, 38.26, "The purifier cleans the air."], [38.54, 39.72, "The sprays hit the surface."], [40.04, 41.62, "But dust mites don't live in the air"], [41.62, 43.36, "and they don't live on top of your sheets."], [43.6, 45.32, "They live deep inside the mattress,"], [45.6, 48.0, "exactly where nothing I was doing could reach them."], [48.14, 49.94, "That's what capture cards takes care of."], [50.06, 52.36, "They go under your pillow and across the mattress,"], [52.5, 53.62, "right where the problem is."], [53.76, 54.58, "And here's what's different."], [54.78, 56.4, "Most traps just sit there and wait."], [56.64, 57.96, "These use a pheromone lure"], [57.96, 60.7, "that actively draws mites out of the mattress fabric."], [60.94, 62.04, "An adhesive traps them."], [62.18, 63.16, "And when you take the card out,"], [63.32, 64.36, "they leave the bed with it."], [64.46, 67.72, "No sprays, no poisons, no filters, no upkeep."], [67.9, 70.52, "The difference I noticed was in how I felt when I woke up."], [70.7, 73.08, "Less stuffy, less foggy, actually rested."], [73.34, 74.26, "You don't have to be convinced."], [74.6, 75.14, "I wasn't."], [75.28, 77.02, "You just have to be willing to find out."], [77.22, 79.0, "90 days, no return required."], [79.34, 80.38, "If you've tried everything,"], [80.68, 83.0, "tap below and find out if your bed is the problem."]]}
ress", 60.46, 60.78], ["anyway.", 60.78, 61.14], ["That's", 61.38, 61.58], ["why", 61.58, 61.72], ["she", 61.72, 61.88], ["ended", 61.88, 62.1], ["up", 62.1, 62.3], ["buying", 62.3, 62.66], ["capture", 62.66, 63.08], ["cards.", 63.08, 63.5], ["Inside", 63.72, 64.0], ["each", 64.0, 64.34], ["card", 64.34, 64.7], ["is", 64.7, 64.98], ["a", 64.98, 65.12], ["plant", 65.12, 65.38], ["-derived", 65.38, 65.76], ["lure", 65.76, 66.12], ["that", 66.12, 66.4], ["attracts", 66.4, 66.84], ["dust", 66.84, 67.22], ["mites", 67.22, 67.64], ["out", 67.64, 67.86], ["of", 67.86, 67.98], ["the", 67.98, 68.06], ["mattress,", 68.06, 68.36], ["and", 68.7, 68.8], ["adhesive", 68.8, 69.22], ["traps", 69.22, 69.68], ["them", 69.68, 69.96], ["on", 69.96, 70.1], ["contact.", 70.1, 70.52], ["You", 70.78, 70.86], ["remove", 70.86, 71.08], ["the", 71.08, 71.32], ["card", 71.32, 71.56], ["and", 71.56, 71.78], ["the", 71.78, 71.88], ["trapped", 71.88, 72.16], ["mites", 72.16, 72.56], ["come", 72.56, 72.7], ["out", 72.7, 72.84], ["with", 72.84, 73.04], ["it.", 73.04, 73.14], ["No", 73.28, 73.38], ["sprays,", 73.38, 73.98], ["no", 74.08, 74.16], ["plugs,", 74.16, 74.56], ["just", 74.86, 74.96], ["slide", 74.96, 75.22], ["the", 75.22, 75.38], ["cards", 75.38, 75.58], ["under", 75.58, 75.84], ["the", 75.84, 75.96], ["mattress", 75.96, 76.28], ["near", 76.28, 76.54], ["the", 76.54, 76.7], ["corners", 76.7, 76.98], ["and", 76.98, 77.34], ["leave", 77.34, 77.52], ["them.", 77.52, 77.7], ["It's", 77.92, 78.1], ["the", 78.1, 78.24], ["only", 78.24, 78.58], ["dust", 78.58, 78.9], ["mite", 78.9, 79.1], ["fix", 79.1, 79.34], ["that", 79.34, 79.56], ["actually", 79.56, 79.96], ["traps", 79.96, 80.42], ["dust", 80.42, 80.82], ["mites.", 80.82, 81.22], ["If", 81.34, 81.44], ["you're", 81.44, 81.6], ["tired", 81.6, 81.86], ["of", 81.86, 82.04], ["getting", 82.04, 82.22], ["into", 82.22, 82.5], ["bed", 82.5, 82.72], ["only", 82.72, 83.06], ["to", 83.06, 83.24], ["start", 83.24, 83.5], ["scratching", 83.5, 83.96], ["again,", 83.96, 84.4], ["give", 84.76, 84.86], ["capture", 84.86, 85.18], ["cards", 85.18, 85.5], ["a", 85.5, 85.62], ["try.", 85.62, 85.8]], "segments": [[0.0, 3.42, "Same skin, same house, one thing missing, the bed."], [3.78, 5.38, "And that was the first night in months"], [5.38, 6.7, "she didn't wake up scratching."], [7.1, 8.76, "One night, she gave up completely."], [9.12, 11.1, "She dragged a yoga mat into the living room,"], [11.28, 12.08, "laid down on the floor,"], [12.36, 14.36, "and that was the first night in months"], [14.36, 17.06, "she woke up without new scratch marks on her skin."], [17.22, 19.6, "And that one night told her more than every cream,"], [19.96, 23.28, "every detergent switch, every fresh set of sheets ever had"], [23.28, 24.96, "because all of those had one thing in common."], [25.16, 27.18, "They treated her skin like the problem."], [27.36, 28.9, "Meanwhile, the actual source"], [28.9, 30.06, "was sitting in the bedroom."], [30.44, 32.06, "For months, she'd done everything right,"], [32.56, 34.22, "moisturized so it couldn't be dryness,"], [34.44, 37.7, "switched detergents, changed sheets, washed everything hot,"], [37.94, 40.66, "and still woke up with marks she didn't remember making."], [40.92, 43.08, "Calm skin during the day, then back into bed,"], [43.3, 44.14, "and it started again."], [44.3, 46.76, "When a doctor finally pointed to dust mites,"], [46.86, 48.7, "a colony living deep inside the mattress,"], [49.0, 50.82, "feeding on shed skin every night,"], [50.98, 52.46, "it wasn't a shock, it was an answer,"], [52.54, 54.34, "and it explained why nothing had worked."], [54.56, 56.22, "She thought she should replace the mattress,"], [56.54, 57.86, "since the mattress is the problem,"], [57.86, 60.04, "until she realized that mites will end up"], [60.04, 61.14, "on the same mattress anyway."], [61.38, 63.5, "That's why she ended up buying capture cards."], [63.72, 66.12, "Inside each card is a plant-derived lure"], [66.12, 68.36, "that attracts dust mites out of the mattress,"], [68.7, 70.52, "and adhesive traps them on contact."], [70.78, 73.14, "You remove the card and the trapped mites come out with it."], [73.28, 74.56, "No sprays, no plugs,"], [74.86, 76.28, "just slide the cards under the mattress"], [76.28, 77.7, "near the corners and leave them."], [77.92, 79.34, "It's the only dust mite fix"], [79.34, 81.22, "that actually traps dust mites."], [81.34, 82.72, "If you're tired of getting into bed"], [82.72, 84.4, "only to start scratching again,"], [84.76, 85.8, "give capture cards a try."]]}
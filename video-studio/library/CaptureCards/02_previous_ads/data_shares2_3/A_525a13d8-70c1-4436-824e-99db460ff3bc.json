aps", 83.26, 83.72], ["dust", 83.72, 84.14], ["mites.", 84.14, 84.5], ["If", 84.6, 84.74], ["you're", 84.74, 84.9], ["tired", 84.9, 85.18], ["of", 85.18, 85.34], ["getting", 85.34, 85.52], ["into", 85.52, 85.8], ["bed,", 85.8, 86.02], ["only", 86.02, 86.34], ["to", 86.34, 86.54], ["start", 86.54, 86.78], ["scratching", 86.78, 87.28], ["again,", 87.28, 87.7], ["give", 88.02, 88.14], ["capture", 88.14, 88.46], ["cards", 88.46, 88.76], ["a", 88.76, 88.92], ["try.", 88.92, 89.08]], "segments": [[0.0, 2.66, "She slept on a yoga mat on the living room floor"], [2.66, 5.5, "because she couldn't take one more night of scratching."], [5.96, 7.6, "And for the first time in months,"], [7.84, 10.1, "she woke up without new marks on her skin."], [10.4, 12.04, "One night, she gave up completely."], [12.42, 14.4, "She dragged a yoga mat into the living room,"], [14.58, 15.4, "laid down on the floor,"], [15.68, 17.62, "and that was the first night in months."], [17.9, 20.38, "She woke up without new scratch marks on her skin."], [20.5, 22.94, "And that one night told her more than every cream,"], [23.26, 24.34, "every detergent switch,"], [24.6, 26.58, "every fresh set of sheets ever had,"], [26.64, 28.26, "because all of those had one thing in common."], [28.26, 30.48, "They treated her skin like the problem."], [30.72, 33.38, "Meanwhile, the actual source was sitting in the bedroom."], [33.76, 35.36, "For months, she'd done everything right,"], [35.52, 37.54, "moisturized so it couldn't be dryness,"], [37.78, 41.0, "switched detergents, changed sheets, washed everything hot,"], [41.24, 43.94, "and still woke up with marks she didn't remember making."], [44.24, 46.38, "Calm skin during the day, then back into bed,"], [46.6, 47.46, "and it started again."], [47.6, 50.04, "When a doctor finally pointed to dust mites,"], [50.16, 52.02, "a colony living deep inside the mattress,"], [52.32, 54.12, "feeding on shed skin every night,"], [54.28, 55.78, "it wasn't a shock, it was an answer,"], [55.86, 57.64, "and it explained why nothing had worked."], [57.64, 59.5, "She thought she should replace the mattress,"], [59.84, 61.14, "since the mattress is the problem,"], [61.36, 62.8, "until she realized that mites"], [62.8, 64.44, "will end up on the same mattress anyway."], [64.68, 66.8, "That's why she ended up buying capture cards."], [67.04, 69.44, "Inside each card is a plant-derived lure"], [69.44, 71.68, "that attracts dust mites out of the mattress,"], [71.96, 73.82, "and adhesive traps them on contact."], [74.06, 74.88, "You remove the card,"], [75.0, 76.44, "and the trapped mites come out with it."], [76.56, 77.86, "No sprays, no plugs,"], [78.12, 79.58, "just slide the cards under the mattress"], [79.58, 81.02, "near the corners and leave them."], [81.2, 82.64, "It's the only dust mite fix"], [82.64, 84.5, "that actually traps dust mites."], [84.6, 86.02, "If you're tired of getting into bed,"], [86.02, 87.7, "only to start scratching again,"], [88.02, 89.08, "give capture cards a try."]]}
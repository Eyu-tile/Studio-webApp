.82], ["the", 81.82, 82.02], ["card,", 82.02, 82.3], ["you", 82.54, 82.64], ["throw", 82.64, 82.92], ["it", 82.92, 83.04], ["away", 83.04, 83.3], ["with", 83.3, 83.48], ["the", 83.48, 83.64], ["mites", 83.64, 83.96], ["it", 83.96, 84.02], ["caught.", 84.02, 84.18], ["You", 84.38, 84.48], ["lift", 84.48, 84.64], ["the", 84.64, 84.8], ["mattress,", 84.8, 85.12], ["slide", 85.48, 85.72], ["the", 85.72, 85.92], ["cards", 85.92, 86.14], ["underneath", 86.14, 86.52], ["and", 86.52, 86.92], ["leave", 86.92, 87.16], ["them", 87.16, 87.36], ["there", 87.36, 87.56], ["for", 87.56, 87.72], ["up", 87.72, 87.86], ["to", 87.86, 88.02], ["90", 88.02, 88.36], ["days.", 88.36, 88.82], ["Nothing", 89.02, 89.12], ["could", 89.12, 89.36], ["plug", 89.36, 89.58], ["in", 89.58, 89.82], ["or", 89.82, 90.06], ["spray", 90.06, 90.34], ["on", 90.34, 90.52], ["the", 90.52, 90.64], ["bed.", 90.64, 90.74], ["I", 90.94, 91.04], ["was", 91.04, 91.18], ["willing", 91.18, 91.38], ["to", 91.38, 91.56], ["try", 91.56, 91.84], ["that", 91.84, 92.06], ["and", 92.06, 92.36], ["see", 92.36, 92.6], ["whether", 92.6, 92.8], ["it", 92.8, 92.96], ["made", 92.96, 93.14], ["any", 93.14, 93.42], ["difference", 93.42, 93.72], ["to", 93.72, 93.98], ["the", 93.98, 94.1], ["itching.", 94.1, 94.4], ["If", 94.64, 94.74], ["you're", 94.74, 94.86], ["getting", 94.86, 95.04], ["into", 95.04, 95.28], ["bed", 95.28, 95.5], ["every", 95.5, 95.7], ["night", 95.7, 95.94], ["and", 95.94, 96.14], ["scratching", 96.14, 96.56], ["without", 96.56, 96.98], ["knowing", 96.98, 97.3], ["why,", 97.3, 97.6], ["I'll", 97.84, 97.98], ["put", 97.98, 98.1], ["the", 98.1, 98.24], ["capture", 98.24, 98.52], ["cards", 98.52, 98.8], ["link", 98.8, 99.02], ["below.", 99.02, 99.34]], "segments": [[0.0, 3.04, "Itchy skin every night, but only after you get into bed?"], [3.32, 5.74, "No rash, no bugs, nothing you can see."], [6.0, 7.42, "Every night, I'd get into bed"], [7.42, 9.86, "and within 10 minutes my skin would start itching."], [10.12, 13.24, "It felt like tiny pinpricks, like invisible needles."], [13.76, 15.42, "Sometimes I didn't even have a rash."], [15.82, 17.2, "I'd look at my arms and legs,"], [17.52, 19.46, "then pull the covers back and check the sheet."], [19.62, 20.8, "I couldn't find any bugs,"], [21.04, 23.76, "but as soon as I settled back down, I'd feel it again."], [24.0, 25.64, "During the day, my skin was fine."], [25.94, 28.5, "Then I'd get into bed that night and start scratching."], [28.5, 31.34, "I just wanted to feel clean and get some sleep."], [31.7, 32.76, "I went online and searched,"], [33.42, 35.8, "why am I itchy in bed but I can't find any bugs?"], [36.06, 37.58, "People were describing the same thing."], [37.78, 39.94, "Even that pinprick feeling I couldn't explain."], [40.3, 42.12, "Dust mite allergies kept coming up."], [42.3, 44.32, "I'd always thought dust mites made people sneeze."], [44.84, 46.92, "I didn't know their allergens could bother your skin too."], [47.22, 48.86, "I started reading about where they live,"], [49.44, 51.0, "mattresses, pillows, bedding,"], [51.16, 53.38, "and they're microscopic, so you can't even see them."], [53.64, 55.74, "The more I read, the more familiar it sounded."], [56.04, 57.44, "I looked into allergy testing,"], [57.44, 60.14, "but I wasn't ready to spend money on a test yet."], [60.26, 62.08, "I was still wondering whether dust mites"], [62.08, 63.08, "had anything to do with it."], [63.22, 65.34, "So I kept looking at what people used for them"], [65.34, 67.14, "and came across capture cards,"], [67.36, 69.46, "little dust mite traps you put under your mattress."], [69.76, 71.8, "I read how they worked because I wanted to know"], [71.8, 73.8, "why a mite would crawl into a card."], [74.04, 76.42, "Turns out there's a plant-derived lure inside"], [76.42, 78.18, "that attracts nearby dust mites."], [78.26, 80.44, "When they crawl in, they get stuck on the adhesive."], [80.78, 82.3, "Then when you replace the card,"], [82.54, 84.18, "you throw it away with the mites it caught."], [84.38, 86.52, "You lift the mattress, slide the cards underneath"], [86.52, 88.82, "and leave them there for up to 90 days."], [89.02, 90.74, "Nothing could plug in or spray on the bed."], [90.94, 92.06, "I was willing to try that"], [92.06, 94.4, "and see whether it made any difference to the itching."], [94.64, 95.94, "If you're getting into bed every night"], [95.94, 97.6, "and scratching without knowing why,"], [97.84, 99.34, "I'll put the capture cards link below."]]}
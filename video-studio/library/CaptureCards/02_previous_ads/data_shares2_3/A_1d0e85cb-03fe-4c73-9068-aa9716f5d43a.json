ou", 81.26, 81.42], ["throw", 81.42, 81.68], ["it", 81.68, 81.8], ["away", 81.8, 82.06], ["with", 82.06, 82.26], ["the", 82.26, 82.38], ["mites", 82.38, 82.68], ["caught.", 82.68, 82.88], ["You", 83.16, 83.22], ["lift", 83.22, 83.42], ["the", 83.42, 83.56], ["mattress,", 83.56, 83.88], ["slide", 84.24, 84.52], ["the", 84.52, 84.7], ["cards", 84.7, 84.9], ["underneath,", 84.9, 85.28], ["and", 85.28, 85.7], ["leave", 85.7, 85.92], ["them", 85.92, 86.14], ["there", 86.14, 86.32], ["for", 86.32, 86.48], ["up", 86.48, 86.62], ["to", 86.62, 86.8], ["90", 86.8, 87.12], ["days,", 87.12, 87.6], ["nothing", 87.76, 87.9], ["to", 87.9, 88.12], ["plug", 88.12, 88.36], ["in", 88.36, 88.58], ["or", 88.58, 88.82], ["spray", 88.82, 89.08], ["on", 89.08, 89.3], ["the", 89.3, 89.38], ["bed.", 89.38, 89.52], ["I", 89.72, 89.82], ["was", 89.82, 89.96], ["willing", 89.96, 90.14], ["to", 90.14, 90.34], ["try", 90.34, 90.6], ["that", 90.6, 90.8], ["and", 90.8, 91.12], ["see", 91.12, 91.36], ["whether", 91.36, 91.58], ["it", 91.58, 91.74], ["made", 91.74, 91.9], ["any", 91.9, 92.18], ["difference", 92.18, 92.48], ["to", 92.48, 92.74], ["the", 92.74, 92.88], ["itching.", 92.88, 93.16], ["If", 93.42, 93.52], ["you're", 93.52, 93.64], ["getting", 93.64, 93.82], ["into", 93.82, 94.04], ["bed", 94.04, 94.26], ["every", 94.26, 94.46], ["night", 94.46, 94.7], ["and", 94.7, 94.9], ["scratching", 94.9, 95.32], ["without", 95.32, 95.74], ["knowing", 95.74, 96.06], ["why,", 96.06, 96.38], ["I'll", 96.6, 96.74], ["put", 96.74, 96.88], ["the", 96.88, 97.0], ["capture", 97.0, 97.28], ["cards", 97.28, 97.56], ["link", 97.56, 97.78], ["below.", 97.78, 98.1]], "segments": [[0.0, 2.38, "My skin was completely fine during the day."], [2.56, 4.36, "I'd get into bed and start scratching."], [4.8, 6.18, "Every night I'd get into bed"], [6.18, 8.62, "and within 10 minutes my skin would start itching."], [8.88, 12.02, "It felt like tiny pinpricks, like invisible needles."], [12.54, 14.18, "Sometimes I didn't even have a rash."], [14.6, 15.96, "I'd look at my arms and legs,"], [16.38, 18.22, "then pull the covers back and check the sheet."], [18.38, 19.52, "I couldn't find any bugs,"], [19.8, 22.54, "but as soon as I settled back down, I'd feel it again."], [22.82, 24.42, "During the day, my skin was fine."], [24.74, 27.32, "Then I'd get into bed that night and start scratching."], [27.32, 30.12, "I just wanted to feel clean and get some sleep."], [30.46, 33.24, "I went online and searched, why am I itchy in bed?"], [33.5, 34.54, "I can't find any bugs."], [34.8, 36.34, "People were describing the same thing."], [36.56, 38.68, "Even that pinprick feeling I couldn't explain."], [39.08, 40.88, "Dust mite allergies kept coming up."], [41.08, 43.16, "I'd always thought dust mites made people sneeze."], [43.62, 45.7, "I didn't know their allergens could bother your skin too."], [45.98, 47.6, "I started reading about where they live,"], [48.14, 49.76, "mattresses, pillows, bedding,"], [49.92, 52.16, "and they're microscopic, so you can't even see them."], [52.4, 54.5, "The more I read, the more familiar it sounded."], [54.8, 56.24, "I looked into allergy testing,"], [56.24, 58.9, "but I wasn't ready to spend money on a test yet."], [59.02, 60.84, "I was still wondering whether dust mites"], [60.84, 61.84, "had anything to do with it."], [62.0, 64.1, "So I kept looking at what people used for them"], [64.1, 65.92, "and came across capture cards."], [66.14, 68.22, "Little dust mite traps you put under your mattress."], [68.52, 70.56, "I read how they worked because I wanted to know"], [70.56, 72.56, "why a mite would crawl into a card."], [72.8, 75.2, "Turns out there's a plant-derived lure inside"], [75.2, 76.96, "that attracts nearby dust mites."], [77.02, 79.22, "When they crawl in, they get stuck on the adhesive."], [79.56, 81.08, "Then when you replace the card,"], [81.26, 82.88, "you throw it away with the mites caught."], [83.16, 85.28, "You lift the mattress, slide the cards underneath,"], [85.28, 87.6, "and leave them there for up to 90 days,"], [87.76, 89.52, "nothing to plug in or spray on the bed."], [89.72, 90.8, "I was willing to try that"], [90.8, 93.16, "and see whether it made any difference to the itching."], [93.42, 94.7, "If you're getting into bed every night"], [94.7, 96.38, "and scratching without knowing why,"], [96.6, 98.1, "I'll put the capture cards link below."]]}
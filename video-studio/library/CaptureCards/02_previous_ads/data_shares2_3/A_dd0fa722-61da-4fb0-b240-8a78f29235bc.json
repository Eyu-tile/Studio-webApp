nts": [[0.0, 3.58, "Hey, I tried all those dust mites fixes and nothing worked."], [3.9, 6.36, "And yeah, I know exactly what you're thinking right now,"], [6.42, 9.26, "because I think it every time I see a Facebook ad too."], [9.6, 13.82, "So before I say anything else, there's a 90 day money back guarantee on this."], [14.1, 14.9, "No return required."], [15.22, 18.08, "You don't have to ship anything back or fight anyone for a refund."], [18.38, 20.22, "If it doesn't work for you, you get your money back."], [20.42, 21.36, "Here's what got me though."], [21.52, 22.88, "I'd been doing everything right."], [23.2, 24.8, "Air purifier running all night."], [25.12, 26.42, "Washing my sheets constantly."], [26.62, 29.68, "And I still woke up every morning stuffed up and foggy."], [29.68, 30.78, "Like I'd barely slept."], [31.14, 33.8, "Then I realized I'd been cleaning the wrong part of my bedroom."], [34.12, 35.56, "The purifier cleans the air."], [35.84, 37.02, "The sprays hit the surface."], [37.32, 38.92, "But dust mites don't live in the air."], [39.06, 40.64, "And they don't live on top of your sheets."], [40.9, 42.6, "They live deep inside the mattress."], [42.9, 45.28, "Exactly where nothing I was doing could reach them."], [45.48, 47.22, "That's what capture cards takes care of."], [47.34, 49.62, "They go under your pillow and across the mattress,"], [49.8, 50.9, "right where the problem is."], [51.06, 51.88, "And here's what's different."], [52.1, 53.7, "Most traps just sit there and wait."], [53.96, 57.98, "These use a pheromone lure that actively draws mites out of the mattress fabric."], [58.2, 59.32, "An adhesive traps them."], [59.32, 61.68, "And when you take the card out, they leave the bed with it."], [61.78, 65.02, "No sprays, no poisons, no filters, no upkeep."], [65.22, 67.82, "The difference I noticed was in how I felt when I woke up."], [68.0, 70.38, "Less stuffy, less foggy, actually rested."], [70.64, 71.56, "You don't have to be convinced."], [71.9, 72.44, "I wasn't."], [72.6, 74.3, "You just have to be willing to find out."], [74.52, 75.08, "90 days."], [75.4, 76.28, "No return required."], [76.64, 77.68, "If you've tried everything,"], [77.98, 80.28, "tap below and find out if your bed is the problem."]]}
4], ["30", 79.34, 79.76], [",000", 79.76, 80.16], ["homes", 80.16, 80.48], ["are", 80.48, 80.68], ["already", 80.68, 81.08], ["sleeping", 81.08, 81.36], ["cleaner.", 81.36, 81.72], ["90", 82.04, 82.28], ["-day", 82.28, 82.5], ["money", 82.5, 82.72], ["-back", 82.72, 82.94], ["guarantee,", 82.94, 83.42], ["link", 83.68, 83.9], ["below.", 83.9, 84.2]], "segments": [[0.0, 3.16, "Every night around 3 a.m., the same side of your nose shuts."], [3.68, 5.66, "You roll over. Now it's the other side."], [5.94, 8.02, "By the time you're up making coffee, it's gone."], [8.38, 12.0, "You've been told it's allergies, or your sinuses, or just getting older."], [12.4, 14.38, "Here's how to check what it really is tonight."], [14.9, 18.72, "If it's always the lower nostril, the side you're lying on, that's not pollen."], [19.06, 20.92, "Pollen doesn't care which side you sleep on."], [21.14, 24.44, "If it switches sides when you roll over, that's not just your sinuses."], [24.74, 26.98, "That's the trigger that follows your face around the pillow."], [26.98, 29.26, "And if it clears within minutes of standing up,"], [29.5, 31.36, "and it's gone a week you sleep somewhere else,"], [31.6, 32.84, "then nobody's telling you this."], [33.1, 34.52, "The problem never leaves your bed."], [34.82, 37.86, "It's the most common thing living in a mattress, just mites."], [38.02, 41.54, "A colony of 100,000 to 10 million of them, deep in the fibers,"], [41.96, 44.46, "feeding on the skin you shed every night, right there,"], [44.68, 46.84, "inches from your face, for eight hours a night."], [47.06, 49.24, "And the worst part, your bedroom can look spotless,"], [49.46, 50.92, "because none of this is in the room."], [51.2, 55.42, "It's inside the mattress, where no wash, spray, or vacuum ever reaches."], [55.42, 58.24, "But here's what actually fixes this, capture cards."], [58.56, 60.04, "Most mite products try to kill them."], [60.32, 61.34, "This one pulls them out."], [61.58, 65.02, "A plant-derived pheromone lure draws the mites up out of the deep fibers."], [65.34, 66.88, "The adhesive locks them on the card,"], [67.12, 70.16, "so what it catches comes out of your bed, instead of back into it."], [70.28, 73.38, "Slide one under the mattress, one near the pillow, and let them work."], [73.58, 75.08, "The colony comes out of the mattress."], [75.44, 76.46, "The card shows you how much."], [76.76, 78.82, "And one card keeps going for about three months."], [79.16, 81.72, "Over 30,000 homes are already sleeping cleaner."], [82.04, 84.2, "90-day money-back guarantee, link below."]]}
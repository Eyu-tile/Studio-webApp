ress", 57.7, 57.98], ["fabric.", 57.98, 58.4], ["An", 58.62, 58.66], ["adhesive", 58.66, 59.02], ["traps", 59.02, 59.44], ["them.", 59.44, 59.74], ["And", 59.9, 59.94], ["when", 59.94, 60.04], ["you", 60.04, 60.14], ["take", 60.14, 60.3], ["the", 60.3, 60.42], ["card", 60.42, 60.64], ["out,", 60.64, 60.86], ["they", 61.0, 61.1], ["leave", 61.1, 61.36], ["the", 61.36, 61.52], ["bed", 61.52, 61.7], ["with", 61.7, 61.9], ["it.", 61.9, 62.06], ["No", 62.18, 62.3], ["sprays,", 62.3, 62.88], ["no", 63.12, 63.24], ["poisons,", 63.24, 63.74], ["no", 63.98, 64.12], ["filters,", 64.12, 64.46], ["no", 64.9, 65.04], ["upkeep.", 65.04, 65.42], ["The", 65.6, 65.66], ["difference", 65.66, 65.9], ["I", 65.9, 66.24], ["noticed", 66.24, 66.54], ["was", 66.54, 66.74], ["in", 66.74, 66.86], ["how", 66.86, 67.08], ["I", 67.08, 67.18], ["felt", 67.18, 67.46], ["when", 67.46, 67.66], ["I", 67.66, 67.78], ["woke", 67.78, 67.96], ["up.", 67.96, 68.22], ["Less", 68.4, 68.5], ["stuffy,", 68.5, 69.0], ["less", 69.14, 69.26], ["foggy,", 69.26, 69.78], ["actually", 69.9, 70.24], ["rested.", 70.24, 70.76], ["You", 71.06, 71.18], ["don't", 71.18, 71.34], ["have", 71.34, 71.46], ["to", 71.46, 71.56], ["be", 71.56, 71.68], ["convinced.", 71.68, 71.94], ["I", 72.32, 72.46], ["wasn't.", 72.46, 72.86], ["You", 73.0, 73.1], ["just", 73.1, 73.38], ["have", 73.38, 73.58], ["to", 73.58, 73.68], ["be", 73.68, 73.78], ["willing", 73.78, 74.04], ["to", 74.04, 74.24], ["find", 74.24, 74.46], ["out.", 74.46, 74.72], ["90", 74.92, 75.18], ["days.", 75.18, 75.48], ["No", 75.86, 76.0], ["return", 76.0, 76.34], ["required.", 76.34, 76.7], ["If", 77.06, 77.16], ["you've", 77.16, 77.34], ["tried", 77.34, 77.54], ["everything,", 77.54, 78.1], ["tap", 78.42, 78.56], ["below", 78.56, 78.9], ["and", 78.9, 79.12], ["find", 79.12, 79.4], ["out", 79.4, 79.54], ["if", 79.54, 79.64], ["your", 79.64, 79.92], ["bed", 79.92, 80.12], ["is", 80.12, 80.28], ["the", 80.28, 80.38], ["problem.", 80.38, 80.7]], "segments": [[0.0, 3.22, "If you wake up stuffed up every morning, you want to hear this."], [3.56, 5.84, "I know what you're thinking, because I've thought it too."], [6.2, 9.4, "Every single time a Facebook ad promises to fix something."], [10.04, 14.22, "So before I say anything else, there's a 90-day money-back guarantee on this."], [14.5, 15.3, "No return required."], [15.62, 18.46, "You don't have to ship anything back or fight anyone for a refund."], [18.76, 20.58, "If it doesn't work for you, you get your money back."], [20.84, 21.74, "Here's what got me, though."], [21.94, 23.3, "I'd been doing everything right."], [23.56, 26.8, "Air purifier running all night, washing my sheets constantly."], [26.8, 31.22, "And I still woke up every morning stuffed up and foggy, like I'd barely slept."], [31.54, 34.22, "Then I realized I'd been cleaning the wrong part of my bedroom."], [34.54, 37.42, "The purifier cleans the air, the sprays hit the surface."], [37.74, 41.04, "But dust mites don't live in the air, and they don't live on top of your sheets."], [41.3, 45.7, "They live deep inside the mattress, exactly where nothing I was doing could reach them."], [45.86, 47.64, "That's what capture cards take care of."], [47.74, 51.32, "They go under your pillow and across the mattress, right where the problem is."], [51.46, 52.28, "And here's what's different."], [52.48, 54.1, "Most traps just sit there and wait."], [54.1, 58.4, "These use a pheromone lure that actively draws mites out of the mattress fabric."], [58.62, 59.74, "An adhesive traps them."], [59.9, 62.06, "And when you take the card out, they leave the bed with it."], [62.18, 65.42, "No sprays, no poisons, no filters, no upkeep."], [65.6, 68.22, "The difference I noticed was in how I felt when I woke up."], [68.4, 70.76, "Less stuffy, less foggy, actually rested."], [71.06, 71.94, "You don't have to be convinced."], [72.32, 72.86, "I wasn't."], [73.0, 74.72, "You just have to be willing to find out."], [74.92, 75.48, "90 days."], [75.86, 76.7, "No return required."], [77.06, 80.7, "If you've tried everything, tap below and find out if your bed is the problem."]]}
], ["actually", 70.84, 71.3], ["take.", 71.3, 71.66], ["See", 71.84, 72.04], ["capture", 72.04, 72.4], ["cards", 72.4, 72.8], ["at", 72.8, 72.96], ["the", 72.96, 73.1], ["link", 73.1, 73.3], ["below.", 73.3, 73.64], ["90", 73.9, 74.14], ["-day", 74.14, 74.42], ["money", 74.42, 74.68], ["-back", 74.68, 74.94], ["guarantee,", 74.94, 75.48], ["no", 75.84, 75.98], ["return", 75.98, 76.36], ["required.", 76.36, 76.64]], "segments": [[0.0, 1.08, "Switch your detergent."], [1.38, 2.4, "Try an antihistamine."], [2.82, 3.84, "It's probably stress."], [4.28, 5.42, "I heard all of it."], [6.0, 9.08, "I'd wake up at 3 a.m. with scratches across my arms,"], [9.46, 11.82, "scratched in my sleep without even realizing it."], [11.92, 14.1, "And there's a difference between seasonal allergies"], [14.1, 17.08, "and waking up at 47 covered in hives"], [17.08, 18.98, "you've never had before in your life."], [19.22, 22.04, "I switched my detergent, I tried antihistamines,"], [22.28, 24.86, "my doctor shrugged and said it was probably stress."], [25.12, 27.42, "None of it explained why this started now."], [27.42, 31.28, "Something changed and I couldn't stop asking, why now?"], [31.56, 33.38, "One thing I'd never thought to look at"], [33.38, 34.78, "was what I was sleeping on."], [35.0, 37.3, "Dust mites live deep inside mattress foam."], [37.5, 40.38, "Their allergens can trigger reactions in sensitized people."], [40.62, 43.12, "Though what's driving any individual symptoms"], [43.12, 45.18, "is something only a doctor can work out."], [45.28, 46.98, "I'm not saying that's everyone's answer."], [47.2, 48.3, "I'm still working with mine,"], [48.48, 50.94, "but capture cards gave me one physical thing"], [50.94, 52.2, "I could actually do."], [52.42, 54.7, "A plant-derived lure draws mites in."], [54.9, 55.94, "They stick to the adhesive."], [55.94, 58.68, "You place four cards under the corners of your mattress,"], [59.0, 60.94, "weave them up to 90 days, then discard."], [61.26, 63.34, "In lab testing, capture cards captured"], [63.34, 65.88, "up to 99% of dust mites."], [65.98, 68.1, "It's not a cure, it's ruling something out."], [68.34, 70.48, "And that felt like the first concrete step"], [70.48, 71.66, "I could actually take."], [71.84, 73.64, "See capture cards at the link below."], [73.9, 76.64, "90-day money-back guarantee, no return required."]]}
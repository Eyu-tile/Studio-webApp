], [45.0, 47.84, "A cover actually seals things inside the mattress"], [47.84, 49.36, "rather than taking them out."], [49.5, 51.88, "So the trigger stays exactly where you sleep."], [52.16, 53.86, "That's where capture cards work differently."], [54.14, 55.9, "A plant-derived pheromone lure"], [55.9, 58.58, "draws dust mites out of hiding inside the mattress."], [59.0, 60.9, "The adhesive captures them on the card."], [61.12, 62.38, "Then the card is discarded,"], [62.6, 65.2, "carrying what it collected out of your bed entirely."], [65.62, 68.56, "One flat card under the mattress, one near the pillow,"], [68.88, 69.96, "works for three months."], [70.36, 73.8, "No spray, no plugs, no change to your laundry routine."], [74.08, 75.66, "Breaking the cycle costs nothing."], [75.98, 77.66, "Try capture cards risk-free"], [77.66, 79.9, "with a 90-day money-back guarantee."]]}
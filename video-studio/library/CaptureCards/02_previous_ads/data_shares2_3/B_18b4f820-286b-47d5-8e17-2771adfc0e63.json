5.52, 45.86], ["off", 45.86, 46.2], ["with", 46.2, 46.58], ["up", 46.58, 46.72], ["to", 46.72, 46.86], ["12", 46.86, 47.18], ["cards", 47.18, 47.52], ["free.", 47.52, 47.84]], "segments": [[0.0, 2.66, "Say goodbye to waking up with puffy eyes."], [3.18, 5.52, "Why not check out true clean capture cards?"], [5.86, 8.54, "Whether you're blowing your nose before your feet hit the floor,"], [8.92, 11.96, "waking up with puffy eyes or scratching half the night,"], [12.4, 13.66, "why not check them out?"], [14.34, 16.9, "Whether you've had it for a month or for 30 years"], [16.9, 19.26, "and you've washed the sheets and backing the mattress"], [19.26, 20.76, "more times than you can count."], [21.08, 22.36, "Capture cards have got your back"], [22.36, 25.2, "and the reason they've got your back is the plant-derive bluer."], [25.46, 28.76, "It pulls dust mites up out of the mattress and onto the card."], [28.76, 31.76, "It's also got an adhesive wearer so once they are on,"], [31.9, 32.56, "they stay on."], [32.98, 35.44, "It's also got nothing to spray and nothing to plug in."], [35.74, 37.26, "Slide it under and forget it."], [37.56, 39.18, "One card lasts three months."], [39.62, 40.84, "If you're dealing with any of these,"], [41.1, 42.88, "why not come and check out Capture Cards?"], [43.2, 44.5, "And right now, for Black Friday,"], [44.66, 47.84, "it's up to 79% off with up to 12 cards free."]]}
86, 84.04], ["start", 84.04, 84.32], ["scratching", 84.32, 84.78], ["again,", 84.78, 85.2], ["give", 85.2, 85.62], ["capture", 85.62, 85.96], ["cards", 85.96, 86.26], ["a", 86.26, 86.42], ["try.", 86.42, 86.56]], "segments": [[0.0, 2.78, "She dragged a yoga mat onto her living room floor"], [2.78, 5.56, "because her own bed had become unbearable."], [5.82, 7.6, "And that night, the itching stopped."], [7.96, 9.58, "One night, she gave up completely."], [9.92, 11.9, "She dragged a yoga mat into the living room,"], [12.08, 12.9, "laid down on the floor,"], [13.14, 15.1, "and that was the first night in months."], [15.4, 17.86, "She woke up without new scratch marks on her skin."], [18.02, 20.42, "And that one night told her more than every cream,"], [20.76, 21.84, "every detergent switch,"], [22.08, 24.08, "every fresh set of sheets ever had,"], [24.14, 25.76, "because all of those had one thing in common."], [25.94, 28.02, "They treated her skin like the problem."], [28.02, 30.9, "Meanwhile, the actual source was sitting in the bedroom."], [31.26, 32.86, "For months, she'd done everything right,"], [33.02, 35.06, "moisturized so it couldn't be dryness,"], [35.24, 38.5, "switched detergents, changed sheets, washed everything hot,"], [38.72, 41.46, "and still woke up with marks she didn't remember making."], [41.68, 43.88, "Calm skin during the day, then back into bed,"], [44.08, 44.94, "and it started again."], [45.1, 47.56, "When a doctor finally pointed to dust mites,"], [47.66, 49.5, "a colony living deep inside the mattress,"], [49.78, 51.64, "feeding on shed skin every night,"], [51.8, 53.26, "it wasn't a shock, it was an answer,"], [53.32, 55.14, "and it explained why nothing had worked."], [55.36, 57.0, "She thought she should replace the mattress,"], [57.0, 58.64, "since the mattress is the problem,"], [58.84, 60.3, "until she realized that mites"], [60.3, 61.94, "will end up on the same mattress anyway."], [62.18, 64.3, "That's why she ended up buying capture cards."], [64.52, 66.94, "Inside each card is a plant-derived lure"], [66.94, 69.18, "that attracts dust mites out of the mattress,"], [69.46, 71.3, "and adhesive traps them on contact."], [71.56, 73.34, "You remove the card and the trapped mites"], [73.34, 73.94, "come out with it."], [74.08, 75.36, "No sprays, no plugs,"], [75.62, 77.08, "just slide the cards under the mattress"], [77.08, 78.5, "near the corners and leave them."], [78.7, 80.14, "It's the only dust mite fix"], [80.14, 82.0, "that actually traps dust mites."], [82.12, 83.5, "If you're tired of getting into bed"], [83.5, 85.2, "only to start scratching again,"], [85.2, 86.56, "give capture cards a try."]]}
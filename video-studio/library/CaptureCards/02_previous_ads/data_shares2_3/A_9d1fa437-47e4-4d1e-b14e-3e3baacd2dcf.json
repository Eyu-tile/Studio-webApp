"segments": [[0.0, 2.18, "Itchy skin every night, but only in bed."], [2.52, 4.08, "So one night I slept on the couch,"], [4.28, 5.24, "just to see what would happen."], [5.66, 7.28, "Itchy skin every single night,"], [7.48, 10.4, "but only after you get into bed, I blamed everything."], [10.72, 13.44, "My lotion, my laundry detergent, my skin itself."], [13.84, 15.4, "During the day, I was completely fine,"], [15.6, 16.9, "same house, same air,"], [17.04, 18.72, "but the second I got under those covers,"], [18.92, 21.48, "this deep itch would start, maybe 10 minutes in."], [21.6, 23.2, "And by four in the morning, I'd wake up"], [23.2, 24.06, "already scratching."], [24.44, 26.92, "One night, I slept on the couch just to test it."], [27.12, 29.48, "The itch didn't come, so I started reading."], [29.48, 32.1, "Dust mites burrow deep inside mattress foam."], [32.28, 34.34, "Deeper than washing or spraying can reach."], [34.58, 36.22, "I almost replaced the whole mattress."], [36.56, 38.08, "Then I found capture cards."], [38.3, 39.72, "They use a plant-derived lure"], [39.72, 42.34, "that attracts mites up from deep inside the foam."], [42.52, 44.78, "They crawl onto the card, the adhesive holds them,"], [44.94, 45.88, "and you throw the card away."], [46.12, 47.84, "Four cards, four corners of your bed,"], [48.0, 49.5, "replace them every 90 days."], [49.78, 52.0, "No spraying your skin, no spraying the mattress,"], [52.2, 53.2, "just a simple step"], [53.2, 54.96, "to help manage the mites where you sleep."], [55.16, 56.78, "See capture cards at the link below."], [56.98, 58.6, "There's a 90-day money-back guarantee,"], [58.6, 60.58, "and you don't even need to return anything."]]}
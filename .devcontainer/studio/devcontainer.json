// Studio in a GitHub Codespace: free on personal accounts (no card), the whole stack in Docker, reachable over
// HTTPS with a team password. Create it with Code > Codespaces > ... > New with options > "Studio".
// See webapp/deploy/codespace/README.md.
{
  "name": "Studio",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {},
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "hostRequirements": { "cpus": 2, "memory": "8gb", "storage": "32gb" },
  "forwardPorts": [8080, 8333],
  "portsAttributes": {
    "8080": { "label": "Studio (set to Public to share)", "onAutoForward": "notify" },
    "8333": { "label": "Studio media (set to Public)", "onAutoForward": "silent" }
  },
  // the build takes 20-40 minutes the first time: it runs in the background so the codespace opens at once
  "postStartCommand": "setsid nohup bash webapp/deploy/codespace/start.sh > /tmp/studio-start.log 2>&1 < /dev/null &",
  // each time the editor connects: where Studio stands (building / running with its address / failed)
  "postAttachCommand": "bash webapp/deploy/codespace/status.sh",
  "customizations": { "codespaces": { "openFiles": ["webapp/deploy/codespace/README.md"] } }
}

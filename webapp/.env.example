# Studio configuration. Copy to webapp/.env and fill in. Every value can also be set as a real environment variable.
# (Comments go on their own lines: an inline comment after an empty value would become the value.)

# production refuses dev sign-in and the default SECRET_KEY
ENV=development
# where people open Studio (cookies, sign-in redirects, bucket CORS)
PUBLIC_URL=http://localhost:3000
# 64+ random characters: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me

# ---- Database and live events (docker-compose sets these for you) ----
DATABASE_URL=postgresql+psycopg://studio:studio@localhost:5432/studio
REDIS_URL=redis://localhost:6379/0

# ---- Media storage: any S3-compatible store ----
S3_BUCKET=studio-media
S3_REGION=us-east-1
# AWS S3: leave both endpoints empty. Cloudflare R2: https://<account-id>.r2.cloudflarestorage.com . Local SeaweedFS (compose):
S3_ENDPOINT_URL=http://localhost:9000
# only when the browser reaches storage at a different address than the servers do
S3_PUBLIC_ENDPOINT_URL=
S3_ACCESS_KEY_ID=studio
S3_SECRET_ACCESS_KEY=studio-dev-secret
# dev only; in production create the bucket and its CORS rule yourself (docs/DEPLOY.md)
S3_CREATE_BUCKET=true

# ---- Sign-in ----
# dev: email only (local machines). oidc: Google Workspace or Microsoft Entra
AUTH_MODE=dev
# https://accounts.google.com   or   https://login.microsoftonline.com/<tenant-id>/v2.0
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# comma list, e.g. yourcompany.com: anyone with a verified email there may sign in (as a member, no brands)
OIDC_ALLOWED_DOMAINS=
# comma list of emails that become admins on first sign-in
BOOTSTRAP_ADMINS=

# ---- Client connections (third-party keys) ----
# local: stored encrypted in the database with this key; aws: AWS Secrets Manager (SECRETS_AWS_PREFIX/brand/<id>/<tool>)
# make a key: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRETS_BACKEND=local
SECRETS_KEY=

# ---- Workers ----
WORKER_ROOT=/tmp/studio-worker
# queues this worker serves: media (ingest, transcribe, render, qa, library scans), agent (Claude turns), or both
WORKER_QUEUES=media,agent
# folder holding faster-whisper-<size>/ models (the worker image bakes "small" into /models)
WHISPER_MODEL_DIR=

# ---- Claude engine (the video-studio plugin in Claude Code, on the workers) ----
# Set on the API and the workers. Either an Anthropic API key, or CLAUDE_CODE_USE_BEDROCK=1 / CLAUDE_CODE_USE_VERTEX=1
# with that cloud's credentials. Without it, everything except the Claude tab works.
ANTHROPIC_API_KEY=
AGENT_MODEL=claude-opus-5-5
# monthly Claude budget per brand (USD) for brands without their own (set on the brand's Settings page); empty = none
AGENT_BRAND_MONTHLY_BUDGET_USD=
# hard spending cap per message (USD); the running total per conversation is shown to editors
AGENT_TURN_BUDGET_USD=5
# tool steps per message before Claude stops and reports
AGENT_MAX_TURNS=80
# an approval nobody answers is declined after this many seconds
AGENT_APPROVAL_TIMEOUT_S=1800
# optional: low | medium | high | xhigh | max
AGENT_EFFORT=

# ---- Isolation of what Claude runs (docs/ARCHITECTURE.md §6.1). Production refuses a turn without the first and third.
# (Left commented out on purpose: an empty value here would override the worker image's settings.)
# Unix user Claude Code runs as (the worker must run as root to switch; the worker image sets studio-agent)
#AGENT_USER=studio-agent
# unprivileged user for vs / ffmpeg / ffprobe when the worker runs as root (the image sets studio)
#WORKER_MEDIA_USER=studio
# Claude Code's sandbox for Bash (needs bubblewrap and socat on Linux). On a dev box without them: false
AGENT_SANDBOX=true
# comma list of domains Claude's commands may reach; empty = the built-in list
AGENT_NETWORK_DOMAINS=
# extra variable names Claude may see (never the worker's credentials). AGENT_ENV_<NAME>=value gives Claude <NAME>.
AGENT_ENV_PASSTHROUGH=
